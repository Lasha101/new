# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test harness (tests/README.md)
# Fixture binaries are generated, not committed: ~20 MB, and regenerating them
# is deterministic (npm run test:fixtures).
tests/fixtures/files/
# Locally vendored WebKit system libraries (npm run pretest:e2e fetches them).
tests/.browser-libs/
# Playwright output
test-results/
playwright-report/
blob-report/
.playwright/

# Local backups of the public site (site1/, site2/, ...). site/ is the source
# of truth; a previous revision of it is already in git history, so committing
# a copy duplicates ~1 MB per snapshot for nothing. Retrieve one instead with:
#     git show <commit>:frontend/site/<page>
site[0-9]*/
