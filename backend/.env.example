# ScanID backend — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored (repo root .gitignore covers
# `.env` and `.env.*`) and must live OUTSIDE the web root on the server, readable
# only by the service account that runs the app:
#
#     chmod 600 .env && chown scanid:scanid .env
#
# Every value below is empty on purpose. Nothing here is a working credential.

# --- Environment ---------------------------------------------------------
# "production" turns on every production behaviour: /docs, /redoc and
# /openapi.json stop being registered, and the session cookie gets Secure.
# Anything else (or unset) means development.
ENVIRONMENT=

# --- Secrets -------------------------------------------------------------
# JWT signing key. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it invalidates every issued session, which is the intended effect.
SECRET_KEY=

# Password for the bootstrap admin account created on first start.
# Must satisfy the password policy: 12+ characters, 1 uppercase, 2 digits,
# 2 special characters, and not a common password.
ADMIN_PASSWORD=

# --- Database ------------------------------------------------------------
# PostgreSQL. On the VPS this points at the LOCAL instance; PostgreSQL should
# not be listening on a public interface.
DATABASE_URL=

# --- Google Cloud Vision -------------------------------------------------
# The service-account key as inline JSON (single line). database.py writes it
# to a 0600 file and points GOOGLE_APPLICATION_CREDENTIALS at it, because the
# Vision client only accepts a path.
GCP_CREDS_JSON=

# Vision endpoint. Defaults to the EU endpoint; this is a data-residency
# commitment for the client DPA, so change it only deliberately.
VISION_API_ENDPOINT=eu-vision.googleapis.com

# --- CORS ----------------------------------------------------------------
# Comma-separated allow-list of browser origins. ONE origin in production.
# Never "*" — and a wildcard would be rejected anyway now that the session
# travels in a cookie.
# Example: https://app.scanid.fr
CORS_ORIGINS=

# --- Uploads -------------------------------------------------------------
# Hard maximum accepted body size, in bytes. Default 15728640 (15 Mo).
MAX_UPLOAD_BYTES=

# --- Rate limiting -------------------------------------------------------
# Upload limit, sized for a batch: the frontend queue sends one request per
# document and retries a transport failure twice (3 attempts), so 10 documents
# is 30 requests, and a "retry failed" pass is 30 more. Default 120/minute.
UPLOAD_RATE_LIMIT=
# Login and registration, per IP. Default 5/minute each.
LOGIN_RATE_LIMIT=
REGISTER_RATE_LIMIT=
# Per-account lockout, which the per-IP limit above cannot provide.
# Default: 10 consecutive failures, 900 seconds.
LOGIN_MAX_FAILURES=
LOGIN_LOCKOUT_SECONDS=

# --- Session cookie ------------------------------------------------------
SESSION_COOKIE_NAME=
# Leave empty to follow ENVIRONMENT (Secure in production). Set to 1/0 to force.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=
